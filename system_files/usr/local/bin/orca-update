#!/bin/bash
set -euo pipefail

# Orca OS - Synchronous Full System Updater

CONFIG_FILE="/etc/orca/release-channel"
DEFAULT_CHANNEL="0.2"

CHANNEL="$DEFAULT_CHANNEL"
if [ -f "$CONFIG_FILE" ]; then
    CHANNEL=$(tr -d '[:space:]' < "$CONFIG_FILE")
fi
[ -z "$CHANNEL" ] && CHANNEL="$DEFAULT_CHANNEL"

case "$CHANNEL" in
    latest|dev|edge)
        TARGET_TAG="latest"
        ;;
    0.1|v0.1)
        TARGET_TAG="v0.1"
        ;;
    0.2|v0.2)
        TARGET_TAG="v0.2"
        ;;
    0.3|v0.3)
        TARGET_TAG="v0.3"
        ;;
    *)
        TARGET_TAG="$CHANNEL"
        ;;
esac

TARGET_IMAGE="ghcr.io/mgrusso/orca:$TARGET_TAG"

echo "🐋 Orca OS — Performing Full System Update..."
echo "=================================================="
echo "Active release channel: $CHANNEL ($TARGET_IMAGE)"

# 1. Base OS Image Update
echo ""
echo "📦 [1/4] Updating base operating system image..."
if command -v rpm-ostree >/dev/null 2>&1; then
    # Extract current image reference cleanly without ANSI escapes
    CURRENT_IMG=$(rpm-ostree status --booted 2>/dev/null | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | grep -oE "ghcr.io/[^ ]+" | head -n 1 || true)
    
    IS_SAME_CHANNEL=false
    if [ -n "$CURRENT_IMG" ]; then
        if [[ "$CURRENT_IMG" == *":$TARGET_TAG"* ]] || [[ "$CURRENT_IMG" == *":$CHANNEL"* ]] || [[ "$CURRENT_IMG" == *":v$CHANNEL"* ]]; then
            IS_SAME_CHANNEL=true
        fi
    fi

    if [ "$IS_SAME_CHANNEL" = true ]; then
        echo "Currently tracking channel '$TARGET_TAG'. Checking for updates..."
        rpm-ostree upgrade || true
    else
        echo "Switching base image to channel '$TARGET_TAG' ($TARGET_IMAGE)..."
        REBASE_SPEC="ostree-unverified-registry:$TARGET_IMAGE"
        if rpm-ostree status 2>/dev/null | grep -q "ostree-image-signed"; then
            REBASE_SPEC="ostree-image-signed:docker://$TARGET_IMAGE"
        fi

        REBASE_OUTPUT=$(rpm-ostree rebase "$REBASE_SPEC" 2>&1 || true)
        echo "$REBASE_OUTPUT"

        if echo "$REBASE_OUTPUT" | grep -qi "unchanged"; then
            echo "Already on this image specification. Checking for updates..."
            rpm-ostree upgrade || true
        fi
    fi
elif command -v bootc >/dev/null 2>&1; then
    CURRENT_IMG=$(bootc status 2>/dev/null | grep -E "image:|Image:" | head -n 1 | awk '{print $NF}' || true)
    if [[ "$CURRENT_IMG" == *":$TARGET_TAG" ]]; then
        bootc upgrade || true
    else
        echo "Switching base image to channel '$TARGET_TAG'..."
        bootc switch "$TARGET_IMAGE" || true
    fi
else
    echo "Neither rpm-ostree nor bootc detected (skipped)."
fi

# 2. Flatpaks Update
echo ""
echo "📦 [2/4] Updating Flatpak applications..."
if command -v flatpak >/dev/null 2>&1; then
    flatpak update -y || true
else
    echo "Flatpak not found (skipped)."
fi

# 3. Homebrew Update
echo ""
echo "📦 [3/4] Updating Homebrew packages..."
if [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv 2>/dev/null)"
    brew update && brew upgrade || true
else
    echo "Homebrew not initialized (skipped)."
fi

# 4. Distrobox Containers Update
echo ""
echo "📦 [4/4] Updating Distrobox containers..."
if command -v distrobox >/dev/null 2>&1; then
    distrobox upgrade -a || true
else
    echo "Distrobox not found (skipped)."
fi

echo ""
echo "=================================================="
echo "✨ Orca OS is now up to date!"
if [ -f /run/reboot-required ] || (command -v rpm-ostree >/dev/null 2>&1 && rpm-ostree status | grep -q "Staged: yes"); then
    echo "🔄 A reboot is required to apply the staged system changes."
    echo "   Run 'sudo systemctl reboot' when you are ready."
fi
