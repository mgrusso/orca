#!/bin/bash
set -euo pipefail

# Orca OS Release Channel Configuration Tool

CONFIG_DIR="/etc/orca"
CONFIG_FILE="${CONFIG_DIR}/release-channel"
DEFAULT_CHANNEL="0.2"

# Ensure config directory exists
if [ ! -d "$CONFIG_DIR" ]; then
    if [ "$EUID" -eq 0 ] || [ -w "/etc" ]; then
        mkdir -p "$CONFIG_DIR"
    else
        sudo mkdir -p "$CONFIG_DIR"
    fi
fi

CURRENT_CHANNEL="$DEFAULT_CHANNEL"
if [ -f "$CONFIG_FILE" ]; then
    CURRENT_CHANNEL=$(tr -d '[:space:]' < "$CONFIG_FILE")
fi
[ -z "$CURRENT_CHANNEL" ] && CURRENT_CHANNEL="$DEFAULT_CHANNEL"

TARGET_INPUT="${1:-}"

if [ -z "$TARGET_INPUT" ]; then
    echo "🐋 Orca OS — Release Channel Configuration"
    echo "==========================================="
    echo "Currently configured channel: [ $CURRENT_CHANNEL ]"
    echo ""
    echo "Available channels:"
    echo "  • 0.2     (or v0.2)   -> Current release line (default, recommended)"
    echo "  • 0.1     (or v0.1)   -> Maintenance release line: latest v0.1.x"
    echo "  • latest              -> Bleeding Edge (daily development build from main)"
    echo ""
    read -p "Select release channel [0.2/0.1/latest]: " TARGET_INPUT
fi

if [ -z "$TARGET_INPUT" ]; then
    echo "No release channel specified. Aborted."
    exit 0
fi

# Normalize channel
case "$TARGET_INPUT" in
    0.2|v0.2)
        CLEAN_CHANNEL="0.2"
        ;;
    0.1|v0.1)
        CLEAN_CHANNEL="0.1"
        ;;
    latest|dev|edge)
        CLEAN_CHANNEL="latest"
        ;;
    *)
        CLEAN_CHANNEL="$TARGET_INPUT"
        ;;
esac

# Write configuration
if [ -w "$CONFIG_DIR" ] || [ "$EUID" -eq 0 ]; then
    echo "$CLEAN_CHANNEL" > "$CONFIG_FILE"
else
    echo "$CLEAN_CHANNEL" | sudo tee "$CONFIG_FILE" >/dev/null
fi

echo ""
echo "✨ Release channel successfully configured to '$CLEAN_CHANNEL'!"
echo "📦 Run 'ujust orca-update' when you are ready to download and apply updates for this channel."
