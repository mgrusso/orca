#!/bin/bash
set -euo pipefail

# Orca OS - Distrobox Development Environment Launcher & Profile Manager

if ! command -v distrobox >/dev/null 2>&1; then
    echo "❌ Error: Distrobox is not installed on this system."
    exit 1
fi

PROFILE="${1:-}"
CUSTOM_IMAGE="${2:-}"

BOX_NAME=""
BOX_IMAGE=""
EXTRA_FLAGS=()

case "$PROFILE" in
    elixir|phoenix|beam)
        BOX_NAME="orca-elixir"
        BOX_IMAGE="docker.io/library/elixir:latest"
        ;;
    fedora|default|"")
        if [ "$PROFILE" = "fedora" ] || [ -n "$CUSTOM_IMAGE" ]; then
            BOX_NAME="${PROFILE:-orca-fedora}"
            BOX_IMAGE="${CUSTOM_IMAGE:-ghcr.io/ublue-os/fedora-toolbox:latest}"
        fi
        ;;
    arch|archlinux)
        BOX_NAME="orca-arch"
        BOX_IMAGE="docker.io/library/archlinux:latest"
        ;;
    rust|cargo)
        BOX_NAME="orca-rust"
        BOX_IMAGE="docker.io/library/rust:latest"
        ;;
    ubuntu)
        BOX_NAME="orca-ubuntu"
        BOX_IMAGE="docker.io/library/ubuntu:latest"
        ;;
    *)
        # Custom user box name
        BOX_NAME="$PROFILE"
        BOX_IMAGE="${CUSTOM_IMAGE:-ghcr.io/ublue-os/fedora-toolbox:latest}"
        ;;
esac

# Interactive profile selection if no argument was passed
if [ -z "$BOX_NAME" ]; then
    echo "🐋 Orca OS — Development Environments (Distrobox)"
    echo "================================================="
    echo "Select a preconfigured development container:"
    echo "  1) elixir   - Elixir, Erlang OTP & Hex (Official elixir image)"
    echo "  2) fedora   - Fedora Toolbox (Standard Universal Blue base)"
    echo "  3) arch     - Arch Linux (Bleeding Edge & AUR access)"
    echo "  4) rust     - Rust Toolchain (Official rust image)"
    echo "  5) ubuntu   - Ubuntu LTS environment"
    echo ""
    read -p "Select environment [1-5 or name] (default: fedora): " CHOICE
    CHOICE="${CHOICE:-2}"

    case "$CHOICE" in
        1|elixir)
            BOX_NAME="orca-elixir"
            BOX_IMAGE="docker.io/library/elixir:latest"
            ;;
        2|fedora)
            BOX_NAME="orca-fedora"
            BOX_IMAGE="ghcr.io/ublue-os/fedora-toolbox:latest"
            ;;
        3|arch)
            BOX_NAME="orca-arch"
            BOX_IMAGE="docker.io/library/archlinux:latest"
            ;;
        4|rust)
            BOX_NAME="orca-rust"
            BOX_IMAGE="docker.io/library/rust:latest"
            ;;
        5|ubuntu)
            BOX_NAME="orca-ubuntu"
            BOX_IMAGE="docker.io/library/ubuntu:latest"
            ;;
        *)
            BOX_NAME="orca-$CHOICE"
            BOX_IMAGE="ghcr.io/ublue-os/fedora-toolbox:latest"
            ;;
    esac
fi

# Create container if it doesn't already exist
if ! distrobox list | grep -w -q "$BOX_NAME"; then
    echo "🐋 Creating new development container '$BOX_NAME' (Image: $BOX_IMAGE)..."
    distrobox create --name "$BOX_NAME" --image "$BOX_IMAGE" -Y
    echo "✨ Container '$BOX_NAME' created successfully."
fi

echo "🚀 Entering development container '$BOX_NAME'..."
distrobox enter "$BOX_NAME"
