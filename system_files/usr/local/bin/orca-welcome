#!/usr/bin/env python3
import sys
import os
import subprocess
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, Gio, GLib

CONFIG_DIR = os.path.expanduser("~/.config/orca")
FLAG_FILE = os.path.join(CONFIG_DIR, "no-show-welcome")
DEFAULT_BROWSER_FILE = os.path.join(CONFIG_DIR, "default-browser")


def is_flatpak_installed(app_id):
    try:
        res = subprocess.run(
            ["flatpak", "info", app_id],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
        return res.returncode == 0
    except Exception:
        return False


def get_current_default_browser():
    if os.path.exists(DEFAULT_BROWSER_FILE):
        try:
            with open(DEFAULT_BROWSER_FILE) as f:
                val = f.read().strip()
                if val:
                    return val
        except Exception:
            pass
    return "firefox"


def set_default_browser(browser_id, desktop_file=None):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    try:
        with open(DEFAULT_BROWSER_FILE, "w") as f:
            f.write(browser_id + "\n")
    except Exception:
        pass

    if desktop_file:
        try:
            subprocess.Popen(["xdg-settings", "set", "default-web-browser", desktop_file])
        except Exception:
            pass

    # Ensure user's ~/.config/niri/config.kdl uses the dynamic orca-browser dispatcher
    niri_conf = os.path.expanduser("~/.config/niri/config.kdl")
    if os.path.exists(niri_conf):
        try:
            with open(niri_conf, "r") as f:
                content = f.read()
            if 'spawn "firefox"' in content:
                content = content.replace('spawn "firefox"', 'spawn "orca-browser"')
                with open(niri_conf, "w") as f:
                    f.write(content)
                subprocess.Popen(["niri", "msg", "action", "reload-config"])
        except Exception:
            pass



def launch_or_install_browser(app_id, name):
    if is_flatpak_installed(app_id):
        subprocess.Popen(["flatpak", "run", app_id])
    else:
        script = f"echo '📦 Installing {name} from Flathub...'; flatpak install -y flathub {app_id} && flatpak run {app_id} || true"
        if subprocess.run(["which", "ghostty"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            subprocess.Popen(["ghostty", "-e", "bash", "-c", script])
        else:
            subprocess.Popen(["flatpak", "install", "-y", "flathub", app_id])


class OrcaWelcomeWindow(Adw.ApplicationWindow):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.set_default_size(860, 640)
        self.set_title("Welcome to Orca OS")

        self.current_page_idx = 0
        self.browser_buttons = {}

        # Main Layout
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_content(main_box)

        # Header Bar
        header = Adw.HeaderBar()
        self.title_label = Gtk.Label(label="Welcome")
        self.title_label.add_css_class("heading")
        header.set_title_widget(self.title_label)
        main_box.append(header)

        # Gtk.Stack for clean, isolated page transitions
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(260)
        self.stack.set_vexpand(True)
        self.stack.set_hexpand(True)
        main_box.append(self.stack)

        # Bottom navigation bar
        bottom_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        bottom_box.set_margin_top(14)
        bottom_box.set_margin_bottom(14)
        bottom_box.set_margin_start(24)
        bottom_box.set_margin_end(24)

        self.btn_prev = Gtk.Button(label="Back")
        self.btn_prev.connect("clicked", self.on_prev_clicked)
        self.btn_prev.set_sensitive(False)
        bottom_box.append(self.btn_prev)

        self.step_label = Gtk.Label(label="Step 1 of 5")
        self.step_label.set_hexpand(True)
        self.step_label.add_css_class("dim-label")
        bottom_box.append(self.step_label)

        self.btn_next = Gtk.Button(label="Next")
        self.btn_next.add_css_class("suggested-action")
        self.btn_next.connect("clicked", self.on_next_clicked)
        bottom_box.append(self.btn_next)

        main_box.append(bottom_box)

        # Build each wizard step
        self.page_names = ["welcome", "theme", "browser", "shortcuts", "finish"]
        self.page_titles = [
            "Welcome to Orca OS",
            "Appearance & Accent",
            "Web Browsers",
            "Shortcuts & Gestures",
            "Ready to Explore"
        ]

        self.build_page_welcome()
        self.build_page_theme()
        self.build_page_browser()
        self.build_page_shortcuts()
        self.build_page_finish()

        self.update_nav()

    def update_nav(self):
        total = len(self.page_names)
        self.btn_prev.set_sensitive(self.current_page_idx > 0)
        self.title_label.set_label(self.page_titles[self.current_page_idx])
        self.step_label.set_label(f"Step {self.current_page_idx + 1} of {total}")

        if self.current_page_idx == total - 1:
            self.btn_next.set_label("Get Started")
        else:
            self.btn_next.set_label("Next")

        self.stack.set_visible_child_name(self.page_names[self.current_page_idx])

    def on_prev_clicked(self, btn):
        if self.current_page_idx > 0:
            self.current_page_idx -= 1
            self.update_nav()

    def on_next_clicked(self, btn):
        total = len(self.page_names)
        if self.current_page_idx < total - 1:
            self.current_page_idx += 1
            self.update_nav()
        else:
            # Finish wizard
            self.on_finish()

    def on_finish(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        # If user did NOT explicitly request to see it on every startup, disable it!
        if not self.check_show_again.get_active():
            try:
                with open(FLAG_FILE, "w") as f:
                    f.write("1\n")
            except OSError:
                pass
        else:
            if os.path.exists(FLAG_FILE):
                try:
                    os.remove(FLAG_FILE)
                except OSError:
                    pass
        self.close()

    def wrap_page(self, widget, max_width=720):
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        scroll.set_hexpand(True)

        clamp = Adw.Clamp()
        clamp.set_maximum_size(max_width)
        clamp.set_margin_top(14)
        clamp.set_margin_bottom(14)
        clamp.set_margin_start(18)
        clamp.set_margin_end(18)
        clamp.set_child(widget)

        scroll.set_child(clamp)
        return scroll

    def build_page_welcome(self):
        # Clean, centered welcome screen with zero-scroll design
        status = Adw.StatusPage()
        status.set_title("Welcome to Orca OS")
        status.set_description(
            "An immutable workstation built on Project Bluefin.\n"
            "Powered by Niri scroll-tiling, Noctalia Shell and Ghostty."
        )
        status.set_icon_name("preferences-desktop-theme")

        cards_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        cards_box.set_halign(Gtk.Align.CENTER)
        cards_box.set_margin_top(20)

        highlights = [
            ("security-high-symbolic", "Immutable Core", "Transactional OSTree\nwith instant rollback"),
            ("view-paged-symbolic", "Scroll-Tiling", "Smooth horizontal window strip\npowered by Niri"),
            ("color-select-symbolic", "Catppuccin Palette", "System-wide theme\nwith live accent sync"),
        ]

        for icon, title, desc in highlights:
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            card.add_css_class("card")
            card.set_margin_start(4)
            card.set_margin_end(4)
            card.set_margin_top(8)
            card.set_margin_bottom(8)
            card.set_size_request(210, -1)

            ic = Gtk.Image.new_from_icon_name(icon)
            ic.set_pixel_size(32)
            ic.set_margin_top(14)
            card.append(ic)

            lbl_t = Gtk.Label(label=title)
            lbl_t.add_css_class("heading")
            card.append(lbl_t)

            lbl_d = Gtk.Label(label=desc)
            lbl_d.add_css_class("dim-label")
            lbl_d.set_justify(Gtk.Justification.CENTER)
            lbl_d.set_margin_bottom(14)
            card.append(lbl_d)

            cards_box.append(card)

        status.set_child(cards_box)
        wrapped = self.wrap_page(status, max_width=760)
        self.stack.add_named(wrapped, "welcome")

    def build_page_theme(self):
        pref_page = Adw.PreferencesPage()
        pref_page.set_title("Appearance")
        pref_page.set_description("Personalize your visual experience.")

        grp_theme = Adw.PreferencesGroup()
        grp_theme.set_title("Color Scheme")
        grp_theme.set_description("Switch between dark and light Catppuccin flavors.")

        row_dark = Adw.ActionRow()
        row_dark.set_title("Catppuccin Mocha (Dark)")
        row_dark.set_subtitle("Deep dark palette with mauve and lavender accents.")
        btn_dark = Gtk.Button(label="Apply Dark")
        btn_dark.set_valign(Gtk.Align.CENTER)
        btn_dark.connect("clicked", lambda b: subprocess.run(["orca-theme", "dark"]))
        row_dark.add_suffix(btn_dark)
        grp_theme.add(row_dark)

        row_light = Adw.ActionRow()
        row_light.set_title("Catppuccin Latte (Light)")
        row_light.set_subtitle("Clean, high-contrast light theme.")
        btn_light = Gtk.Button(label="Apply Light")
        btn_light.set_valign(Gtk.Align.CENTER)
        btn_light.connect("clicked", lambda b: subprocess.run(["orca-theme", "light"]))
        row_light.add_suffix(btn_light)
        grp_theme.add(row_light)

        grp_wall = Adw.PreferencesGroup()
        grp_wall.set_title("Dynamic Wallpaper & Accent Synchronization")
        grp_wall.set_description("Harmonize Niri active window borders with your wallpaper.")

        row_wall = Adw.ActionRow()
        row_wall.set_title("Shuffle Wallpaper & Harmonize Accent")
        row_wall.set_subtitle("Extracts primary colors from wallpaper and updates Niri focus outline live.")
        btn_wall = Gtk.Button(label="Sync Wallpaper")
        btn_wall.set_valign(Gtk.Align.CENTER)
        btn_wall.connect("clicked", lambda b: subprocess.Popen(["orca-wallpaper-sync", "random"]))
        row_wall.add_suffix(btn_wall)
        grp_wall.add(row_wall)

        pref_page.add(grp_theme)
        pref_page.add(grp_wall)

        wrapped = self.wrap_page(pref_page, max_width=720)
        self.stack.add_named(wrapped, "theme")

    def build_page_browser(self):
        pref_page = Adw.PreferencesPage()
        pref_page.set_title("Web Browsers")
        pref_page.set_description("Choose and configure your default browser (Super + B).")

        grp = Adw.PreferencesGroup()
        grp.set_title("Browser Selection & Shortcut (Super + B)")
        grp.set_description("Choose your preferred browser. Super + B will immediately launch your selected default.")

        browsers = [
            ("firefox", "Mozilla Firefox", "org.mozilla.firefox.desktop", "Pre-installed Flatpak configured with Orca dark mode.", True),
            ("brave", "Brave Browser", "com.brave.Browser.desktop", "Privacy-focused Chromium with built-in ad blocking.", False),
            ("vivaldi", "Vivaldi Browser", "com.vivaldi.Vivaldi.desktop", "Power-user browser with tab stacks and split-view.", False),
        ]

        current_def = get_current_default_browser()

        for b_id, b_name, b_desktop, b_desc, is_preinstalled in browsers:
            row = Adw.ActionRow()
            row.set_title(b_name)
            row.set_subtitle(b_desc)

            btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            btn_box.set_valign(Gtk.Align.CENTER)

            # Default indicator / toggle button
            btn_default = Gtk.Button(label="✓ Default (Super+B)" if current_def == b_id else "Set Default")
            if current_def == b_id:
                btn_default.add_css_class("suggested-action")
            btn_default.connect("clicked", self.create_set_default_handler(b_id, b_desktop))
            self.browser_buttons[b_id] = btn_default
            btn_box.append(btn_default)

            # Launch or Install action button
            if is_preinstalled or is_flatpak_installed(f"com.{b_id}.{b_name.split()[0]}"):
                btn_launch = Gtk.Button(label="Launch")
                if is_preinstalled:
                    btn_launch.connect("clicked", lambda b: subprocess.Popen(["firefox"]))
                else:
                    app_ref = "com.brave.Browser" if b_id == "brave" else "com.vivaldi.Vivaldi"
                    btn_launch.connect("clicked", lambda b, ref=app_ref: subprocess.Popen(["flatpak", "run", ref]))
                btn_box.append(btn_launch)
            else:
                app_ref = "com.brave.Browser" if b_id == "brave" else "com.vivaldi.Vivaldi"
                btn_install = Gtk.Button(label="Install")
                btn_install.connect("clicked", lambda b, ref=app_ref, n=b_name: launch_or_install_browser(ref, n))
                btn_box.append(btn_install)

            row.add_suffix(btn_box)
            grp.add(row)

        pref_page.add(grp)
        wrapped = self.wrap_page(pref_page, max_width=720)
        self.stack.add_named(wrapped, "browser")

    def create_set_default_handler(self, browser_id, desktop_file):
        def handler(btn):
            set_default_browser(browser_id, desktop_file)
            for b_key, b_btn in self.browser_buttons.items():
                if b_key == browser_id:
                    b_btn.set_label("✓ Default (Super+B)")
                    b_btn.add_css_class("suggested-action")
                else:
                    b_btn.set_label("Set Default")
                    b_btn.remove_css_class("suggested-action")
        return handler

    def build_page_shortcuts(self):
        pref_page = Adw.PreferencesPage()
        pref_page.set_title("Keybindings & Gestures")
        pref_page.set_description("Get productive quickly with these essential keyboard shortcuts.")

        grp = Adw.PreferencesGroup()
        grp.set_title("Essential Shortcuts")

        shortcuts = [
            ("Super + Space", "Open Noctalia Application Launcher"),
            ("Super + Return / Super + T", "Launch Ghostty Terminal"),
            ("Super + B", "Launch your default web browser"),
            ("Super + Left / Right", "Navigate scroll-tiling columns (or trackpad gesture)"),
            ("Super + Shift + W", "Shuffle wallpaper and harmonize accent colors"),
            ("Print / Super + Shift + S", "Take screenshot with Satty annotation editor"),
            ("Super + Shift + R", "Toggle screen recording (wf-recorder)"),
            ("Super + Shift + L", "Lock desktop session via Noctalia (or Ctrl+Alt+L)"),
            ("Super + 1 ... 9", "Switch to workspace 1 through 9"),
            ("Super + ?", "Show keyboard shortcuts cheatsheet overlay"),

        ]

        for key, desc in shortcuts:
            row = Adw.ActionRow()
            row.set_title(desc)
            lbl = Gtk.Label(label=key)
            lbl.add_css_class("dim-label")
            lbl.add_css_class("monospace")
            row.add_suffix(lbl)
            grp.add(row)

        pref_page.add(grp)
        wrapped = self.wrap_page(pref_page, max_width=720)
        self.stack.add_named(wrapped, "shortcuts")

    def build_page_finish(self):
        status = Adw.StatusPage()
        status.set_title("You're All Set!")
        status.set_description(
            "Orca OS is configured and ready for your daily workflow.\n"
            "Press 'Get Started' to begin exploring your desktop."
        )
        status.set_icon_name("emblem-default-symbolic")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_halign(Gtk.Align.CENTER)
        box.set_margin_top(20)

        btn_term = Gtk.Button(label="Open Ghostty Terminal")
        btn_term.add_css_class("pill")
        btn_term.add_css_class("suggested-action")
        btn_term.connect("clicked", lambda b: subprocess.Popen(["ghostty"]))
        box.append(btn_term)

        # Autostart toggle: Unchecked by default!
        # When unchecked, clicking "Get Started" creates no-show-welcome so it won't run again.
        self.check_show_again = Gtk.CheckButton(label="Show this welcome tour on next startup")
        self.check_show_again.set_active(False)
        self.check_show_again.set_halign(Gtk.Align.CENTER)
        self.check_show_again.set_margin_top(16)
        box.append(self.check_show_again)

        status.set_child(box)
        wrapped = self.wrap_page(status, max_width=720)
        self.stack.add_named(wrapped, "finish")


class OrcaWelcomeApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="org.orca.welcome",
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = OrcaWelcomeWindow(application=self)
        win.present()


if __name__ == "__main__":
    app = OrcaWelcomeApp()
    sys.exit(app.run(sys.argv))
